generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id              String    @id
  name            String
  description     String?
  color           String?   @db.VarChar(7)
  active          Boolean   @default(true)
  parentClientId  String?   @map("parent_client_id") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  notes           Note[]    @relation("ClientNotes")
  projects        Project[]
  timesheetEntries Timesheet[] @relation("TimesheetClient")
  taskTodos        TaskTodo[] @relation("ClientTodos")
  
  parentClient    Client?   @relation("ClientHierarchy", fields: [parentClientId], references: [id], onUpdate: NoAction)
  subClients      Client[]  @relation("ClientHierarchy")

  @@index([parentClientId], map: "idx_clients_parent")
  @@map("clients")
}

model Project {
  id          String   @id
  name        String
  code        String?  @map("code")
  description String?
  clientId    String   @map("client_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  notes       Note[]   @relation("ProjectNotes")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  timesheetEntries Timesheet[] @relation("TimesheetProject")

  @@index([clientId])
  @@map("projects")
}

model Note {
  id                    String          @id
  type                  NoteType
  title                 String
  content               String?
  projectId             String?         @map("project_id")
  clientId              String?         @map("client_id")
  archived              Boolean         @default(false)
  isFavorite            Boolean         @default(false) @map("is_favorite")
  favoriteOrder         Int?            @map("favorite_order")
  attachments           Json?
  taskStatus            TaskStatus?     @map("task_status")
  taskPriority          TaskPriority?   @map("task_priority")
  taskDueDate           DateTime?       @map("task_due_date")
  connectionUrl         String?         @map("connection_url")
  connectionUsername    String?         @map("connection_username")
  connectionCredentials String?         @map("connection_credentials")
  // Legacy timesheet fields (kept for backward compatibility)
  timesheetDate         DateTime?       @map("timesheet_date")
  timesheetHours        Float?          @map("timesheet_hours")
  timesheetRate         Float?          @map("timesheet_rate")
  timesheetState        TimesheetState? @default(DRAFT) @map("timesheet_state")
  timesheetTaskId       String?         @map("timesheet_task_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  contentJson           Json?           @map("content_json")
  taskTicketPhaseCode   String?         @map("task_ticket_phase_code")
  taskShortDescription  String?         @map("task_short_description")
  taskBudgetHours       Float?          @map("task_budget_hours")
  client                Client?         @relation("ClientNotes", fields: [clientId], references: [id])
  project               Project?        @relation("ProjectNotes", fields: [projectId], references: [id])
  attachmentFiles       Attachment[]
  activityLogs          TaskActivityLog[]
  timesheetEntries      Timesheet[]     @relation("TimesheetTask")
  comments              TaskComment[]   @relation("TaskComments")
  todos                 TaskTodo[]      @relation("TaskTodos")
  // Self-relation for timesheet tasks
  linkedTimesheetTask   Note?           @relation("TimesheetTaskLink", fields: [timesheetTaskId], references: [id])
  linkedTimesheetNotes  Note[]          @relation("TimesheetTaskLink")

  @@index([type])
  @@index([projectId])
  @@index([clientId])
  @@index([archived])
  @@index([isFavorite])
  @@index([timesheetTaskId])
  @@map("notes")
}

enum NoteType {
  GENERAL
  TASK
  CONNECTION
  TIMESHEET
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TimesheetState {
  DRAFT
  FINAL
}

model Attachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noteId       String   @map("note_id")
  filename     String   @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  data         Bytes
  createdAt    DateTime @default(now()) @map("created_at")

  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("attachments")
}

model TaskActivityLog {
  id          String    @id @db.VarChar(36)
  taskId      String    @map("task_id") @db.VarChar(255)
  eventType   String    @map("event_type") @db.VarChar(50)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  task        Note      @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([taskId], map: "idx_task_activity_task_id")
  @@index([createdAt], map: "idx_task_activity_created")
  @@map("task_activity_logs")
}

model Timesheet {
  id          String          @id
  workDate    DateTime        @map("work_date") @db.Timestamp(6)
  hoursWorked Float           @map("hours_worked")
  description String?
  taskId      String?         @map("task_id")
  projectId   String?         @map("project_id")
  clientId    String?         @map("client_id")
  rate        Float?          @map("timesheet_rate")
  state       TimesheetState? @default(DRAFT) @map("timesheet_state")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime        @default(now()) @map("updated_at") @db.Timestamp(6)

  task        Note?           @relation("TimesheetTask", fields: [taskId], references: [id], onUpdate: NoAction)
  project     Project?        @relation("TimesheetProject", fields: [projectId], references: [id], onUpdate: NoAction)
  client      Client?         @relation("TimesheetClient", fields: [clientId], references: [id], onUpdate: NoAction)

  @@index([taskId], map: "Timesheet_task_id_idx")
  @@index([projectId], map: "Timesheet_project_id_idx")
  @@index([clientId], map: "Timesheet_client_id_idx")
  @@index([workDate], map: "Timesheet_work_date_idx")
  @@map("timesheets")
}

model TaskComment {
  id        String   @id
  taskId    String   @map("task_id")
  author    String
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  task      Note     @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
  @@map("task_comments")
}

// TODOs attached to tasks (REQ-021)
model TaskTodo {
  id                  String    @id @default(uuid())
  taskId              String?   @map("task_id")
  clientId            String?   @map("client_id")
  author              String
  content             Json
  deadline            DateTime?
  status              String    @default("pending") // pending, completed, deleted
  completedAt         DateTime? @map("completed_at")
  deletedAt           DateTime? @map("deleted_at")
  snoozedUntil        DateTime? @map("snoozed_until")
  recurrenceRule      String?   @map("recurrence_rule")
  recurrenceParentId  String?   @map("recurrence_parent_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  task                Note?     @relation("TaskTodos", fields: [taskId], references: [id], onDelete: Cascade)
  client              Client?   @relation("ClientTodos", fields: [clientId], references: [id], onDelete: Cascade)
  recurrenceParent    TaskTodo? @relation("RecurrenceTodos", fields: [recurrenceParentId], references: [id])
  recurrenceChildren  TaskTodo[] @relation("RecurrenceTodos")
  notificationsSent   TodoNotificationSent[]

  @@index([taskId, status])
  @@index([clientId, status])
  @@index([deadline, status])
  @@index([snoozedUntil])
  @@map("task_todos")
}

// Tracking sent notifications to avoid duplicates (REQ-021)
model TodoNotificationSent {
  id               String   @id @default(uuid())
  todoId           String   @map("todo_id")
  notificationType String   @map("notification_type") // daily_summary, reminder, overdue
  reminderMinutes  Int?     @map("reminder_minutes")
  sentAt           DateTime @default(now()) @map("sent_at")

  todo             TaskTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId, notificationType])
  @@map("todo_notifications_sent")
}
