# ============================================================
# .env.example — copy to .env for local development
# ============================================================

# PostgreSQL connection string
# For local dev pointing to a remote Docker server:
DATABASE_URL="postgresql://postgres:postgres@192.168.100.113:5432/pietrosoft_notes"

# ============================================================
# Variables set automatically by docker-compose / redeploy.sh
# (no need to set these manually in .env)
# ============================================================

# Path where attachments are stored inside the container
# WORKSPACE_PATH=/data

# Directory for backup files
# BACKUP_DIR=/backups

# Host directory where server backups are persisted when running Docker
# locally this can stay unset; on remote servers it defaults to:
# BACKUP_HOST_DIR=/opt/bitacora-backups

# Node environment (set to "production" by docker-compose)
# NODE_ENV=production

# Deployment environment identifier: "production" or "test"
# Controls the TEST banner in the UI.
# Set automatically by redeploy.sh based on target host.
# APP_ENV=production

# For deploys, use the explicit env files:
#   .env.production for production
#   .env.test for test
# These files are copied to `.env` on the remote host during redeploy.
