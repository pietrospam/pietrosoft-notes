      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Hola Buenas!  Eze, estos 4 temas los estimo en un total de ",
              "type": "text"
            },
            {
              "text": "8 hs .",
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "hardBreak"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "En el CIU no sale impreso cuando la cosecha es mecánica:  1 hs",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Egreso de Teu simple con cero bines: 2 hs",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Crear TEU desde app:  2 hs",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Guardar antes de anunciar: 3hs",
              "type": "text"
            }
          ]
        }
      ]
    },
    "createdAt": "2026-05-04T15:31:20.581Z"
