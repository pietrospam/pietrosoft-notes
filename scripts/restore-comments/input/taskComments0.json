    "author": "usuario",
    "content": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Hola Esperanza, ",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Quería consultarte 2 cosas en cuanto a la lógica:",
              "type": "text"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "type": null,
            "start": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "No encuentro la tabla ",
                      "type": "text"
                    },
                    {
                      "text": "FE1FERI",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": ", ¿Será que tiene otro nombre?",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "La tabla ",
                      "type": "text"
                    },
                    {
                      "text": "F55ADFR, ",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": "se utiliza actualmente por ejemplo en P0411 botón \"",
                      "type": "text"
                    },
                    {
                      "text": "Imagen",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": "\". ¿Cómo podemos saber si el documento es de Seres o de otro origen?",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Aguardo tus comentarios. ",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
