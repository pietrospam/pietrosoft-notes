# Production environment file deployed to the production server.
# This file is copied to .env on the remote host by scripts/redeploy.sh.

DATABASE_NAME=bitacora
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/bitacora"
APP_HOST_PORT=3001
ADMINER_HOST_PORT=8080
WORKSPACE_PATH=/data
BACKUP_DIR=/backups
BACKUP_HOST_DIR=/opt/bitacora-backups
NODE_ENV=production
APP_ENV=production
